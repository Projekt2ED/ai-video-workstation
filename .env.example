# 火山引擎配置
PORT=3000
NODE_ENV=development

# AI MediaKit（语音识别）
MEDIAKIT_API_KEY=your_mediakit_api_key
MEDIAKIT_BASE_URL=https://mediakit.cn-beijing.volces.com/api/v1

# ARK 大模型
ARK_API_KEY=your_ark_api_key
ARK_MODEL=your_endpoint_id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# TOS 存储
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=your_bucket_name

# VOD 点播
VOD_SPACE_NAME=your_space_name

# 火山引擎凭证
VOLC_ACCESS_KEY_ID=your_access_key_id
VOLC_SECRET_ACCESS_KEY=your_secret_access_key
